# BlockerGraph AI - Global Environment Configuration

# Server Settings
PORT=5000
NODE_ENV=development
# Allowed frontend origins for CORS (comma-separated). Leave blank to allow any calling origin dynamically.
CORS_ORIGIN=https://blockergraph-ai.vercel.app,http://localhost:3000

# Optional Supabase Database Configuration
# Leave blank to run with local persistent JSON database engine
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Client Settings (Vercel Production)
# Leave blank for local development (uses Vite proxy).
# In production on Vercel, set VITE_API_URL to your deployed backend URL:
# Example: https://blockergraph-api.onrender.com
VITE_API_URL=
